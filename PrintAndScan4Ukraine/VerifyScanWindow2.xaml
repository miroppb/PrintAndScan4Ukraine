<Window x:Class="PrintAndScan4Ukraine.VerifyScanWindow2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Verify Packages"
    Height="590" Width="600"
    Background="{StaticResource PageBackground}"
    WindowStartupLocation="CenterScreen"
    Icon="/barcode.png">
    <Window.Resources>
        <Storyboard x:Key="FlashAnimation">
            <ColorAnimation Storyboard.TargetName="FlashBorder"
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            From="#A7D8FF" To="Transparent" Duration="0:0:0.25" AutoReverse="False" />
        </Storyboard>
        <Style TargetType="ListViewItem" x:Key="StatusListViewItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Exists}" Value="True">
                    <Setter Property="Background" Value="#D1FAE5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter Property="Background" Value="#FEE2E2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Style="{StaticResource Card}" Padding="20" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Verify Packages" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeaderText}" HorizontalAlignment="Center" Margin="0 0 0 10" />
                <Border x:Name="FlashBorder" CornerRadius="6" Padding="12" Margin="0 0 0 8">
                    <Border.Background>
                        <SolidColorBrush Color="Transparent" />
                    </Border.Background>
                    <TextBlock x:Name="TxtCurrent" Text="Ready to scan..." FontSize="18" Foreground="#374151" TextAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 8">
                    <TextBlock Text="Total: " FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalScanned}" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="4 0 12 0" VerticalAlignment="Center" />
                    <TextBlock Text="Exists: " FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ExistsCount}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" Margin="4 0 12 0" VerticalAlignment="Center" />
                    <TextBlock Text="Not found: " FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NotFoundCount}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="4 0 0 0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Scanned packages (green = exists, red = not found)" FontSize="12" Foreground="#374151" Margin="0 0 0 8" />
                <ListView x:Name="LvScanned" ItemsSource="{Binding ScannedItems}" ItemContainerStyle="{StaticResource StatusListViewItem}" Height="320">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Package" Width="320" DisplayMemberBinding="{Binding Barcode}" />
                            <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding StatusText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="Press Esc to close" FontSize="12" Foreground="#374151" HorizontalAlignment="Center" Margin="0 8 0 0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
